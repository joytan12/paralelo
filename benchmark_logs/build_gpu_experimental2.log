mkdir -p build
nvcc -arch=sm_89 -O2 -std=c++17 -c src/main.cu -o build/main.o
nvcc -arch=sm_89 -O2 -std=c++17 -c src/octree.cu -o build/octree.o
nvcc -arch=sm_89 -O2 -std=c++17 -c src/geometry.cu -o build/geometry.o
nvcc -arch=sm_89 -O2 -std=c++17 -c src/mesh_classify.cu -o build/mesh_classify.o
nvcc -arch=sm_89 -O2 -std=c++17 -c src/stats.cu -o build/stats.o
nvcc -arch=sm_89 -O2 -std=c++17 -c src/merge.cu -o build/merge.o
nvcc -arch=sm_89 -O2 -std=c++17 -x cu -c src/vtk_merged_writer.cpp -o build/vtk_merged_writer.o
nvcc -arch=sm_89 -O2 -std=c++17 -o octree_merged build/main.o build/octree.o build/geometry.o build/mesh_classify.o build/stats.o build/merge.o build/vtk_merged_writer.o
